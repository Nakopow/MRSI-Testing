# ═══════════════════════════════════════════════════════════════════════════════
# TLP Platform - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# REQUIRED for pipeline to work:
#   1. GEMINI_API_KEY - Get from https://aistudio.google.com/apikey
#   2. feeds.json - Create from feeds.json.template with your RSS feed URLs
#
# For Vercel deployment, add these environment variables in your Vercel dashboard.
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Keys (REQUIRED) ───────────────────────────────────────────────────────

# Google Gemini API Key - REQUIRED for AI summarization
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── API Keys (OPTIONAL) ───────────────────────────────────────────────────────

# OpenAI API Key (optional, for additional AI features)
OPENAI_API_KEY=

# Mailchimp API Key (optional, for newsletter delivery)
MAILCHIMP_API_KEY=

# ── Storage Backend ──────────────────────────────────────────────────────────

# Storage backend type: auto, supabase, s3, local
STORAGE_BACKEND=auto

# Supabase Storage (recommended for Vercel production deployment)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=tlp-artifacts

# AWS S3 Storage (alternative)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=tlp-artifacts
AWS_REGION=us-east-1

# ── Flask Configuration ──────────────────────────────────────────────────────

FLASK_DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── Image Generation ─────────────────────────────────────────────────────────

# Image generation backend: huggingface, gemini, none
IMAGE_BACKEND=huggingface
HF_API_TOKEN=
HF_IMAGE_MODEL=runwayml/stable-diffusion-v1-5
GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001
IMAGE_STYLE_PRESET=bold

# ── Scraper Configuration ────────────────────────────────────────────────────

ARTICLE_HOURS_LOOKBACK=24
MAX_ENTRIES_PER_FEED=50
REQUEST_DELAY_SECONDS=1
REQUEST_TIMEOUT_SECONDS=30
MAX_ARTICLE_WORDS=2000
MIN_KEYWORD_MATCHES=1
