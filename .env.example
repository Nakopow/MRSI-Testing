# ═══════════════════════════════════════════════════════════════════════════════
# MRSI Platform - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# REQUIRED for pipeline to work:
#   1. GEMINI_API_KEY - Get from https://aistudio.google.com/apikey
#   2. feeds.json - Create from feeds.json.template with your RSS feed URLs
#
# For Vercel deployment, add these environment variables in your Vercel dashboard.
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Keys (REQUIRED) ───────────────────────────────────────────────────────

# Google Gemini API Key - REQUIRED for AI summarization
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── API Keys (OPTIONAL) ───────────────────────────────────────────────────────

# OpenAI API Key (optional, for additional AI features)
OPENAI_API_KEY=

# Mailchimp API Key (optional, for newsletter delivery)
MAILCHIMP_API_KEY=

# ── Storage Backend ──────────────────────────────────────────────────────────

# Storage backend type: auto, supabase, s3, local
# Default: auto (auto-detects based on available credentials)
STORAGE_BACKEND=auto

# Supabase Storage (recommended for Vercel production deployment)
# Get these from your Supabase project settings:
# - SUPABASE_URL: Your project URL (e.g., https://xxxxx.supabase.co)
# - SUPABASE_KEY: Your service_role key (NOT the anon key) for server-side access
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=mrsi-artifacts

# AWS S3 Storage (alternative)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=mrsi-artifacts
AWS_REGION=us-east-1

# Local Storage (development only)
LOCAL_STORAGE_PATH=.

# ── Flask Configuration ──────────────────────────────────────────────────────

# Flask secret key for sessions
SECRET_KEY=your-secret-key-here

# Flask debug mode (set to false in production)
FLASK_DEBUG=false

# Server host and port
HOST=0.0.0.0
PORT=8000

# ── Image Generation ─────────────────────────────────────────────────────────

# Image generation backend: huggingface, gemini, none
IMAGE_BACKEND=huggingface

# Hugging Face API Token (for image generation)
HF_API_TOKEN=

# Hugging Face Image Model
HF_IMAGE_MODEL=runwayml/stable-diffusion-v1-5

# Gemini Image Model (if using Gemini for images)
GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001

# Image style preset: bold, cinematic, minimal, neon, corporate
IMAGE_STYLE_PRESET=bold

# ── Scraper Configuration ────────────────────────────────────────────────────

# Number of hours to look back for articles
ARTICLE_HOURS_LOOKBACK=24

# Maximum entries to fetch per feed
MAX_ENTRIES_PER_FEED=50

# Delay between requests (seconds)
REQUEST_DELAY_SECONDS=1

# Request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=30

# Maximum words per article
MAX_ARTICLE_WORDS=2000

# Minimum keyword matches required
MIN_KEYWORD_MATCHES=1